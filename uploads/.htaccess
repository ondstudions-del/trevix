# ==============================================================================
# TREVIX · Archivos subidos por usuarios
# Nunca se ejecuta código en esta carpeta: solo se sirven imágenes, videos y canciones.
# ==============================================================================

Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<FilesMatch "(?i)\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|svg|js|htaccess)$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(jpe?g|png|webp|gif|mp4|webm|mov|mp3|m4a)$">
    Require all granted
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; sandbox"

    # Debe ir en FilesMatch para prevalecer sobre el del .htaccess raíz.
    # "private" impide que el CDN conserve archivos de publicaciones ya borradas.
    <FilesMatch "(?i)\.(jpe?g|png|webp|gif|mp4|webm|mov|mp3|m4a)$">
        Header set Cache-Control "private, max-age=86400"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType audio/mpeg .mp3
    AddType audio/mp4 .m4a
</IfModule>
