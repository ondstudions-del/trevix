<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- trevix_bg está en colors.xml (claro) y values-night/colors.xml (oscuro), como el tema «Sistema» de la app. -->
    <!-- Mientras arranca Flutter. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/trevix_bg</item>
    </style>
    <!-- Detrás de la app ya iniciada (se ve al girar o al abrir el teclado). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/trevix_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/trevix_bg</item>
    </style>
</resources>
